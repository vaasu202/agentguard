# AgentGuard always boots in deterministic demo mode when live credentials are absent.
AGENTGUARD_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI Responses API + OpenAI Agents SDK
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6

# Hosted LiteLLM gateway (central provider routing)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_MASTER_KEY=

# Hosted OpenAI-compatible vLLM endpoint (no local model download)
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=

# Hosted Python intelligence service: LangGraph, PydanticAI, LlamaIndex, DSPy
PYTHON_SERVICE_URL=
PYTHON_SERVICE_API_KEY=
# Set this to the same value inside the hosted Python service.
SERVICE_API_KEY=

# Hosted persistence and retrieval
DATABASE_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentguard-context
EMBEDDING_MODEL=text-embedding-3-small

# Hosted Phoenix / OpenTelemetry
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=agentguard

# Optional real MCP tool credentials
GITHUB_TOKEN=
GITHUB_REPOSITORY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
